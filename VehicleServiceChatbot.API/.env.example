# ===================================================================
# Vehicle Service Chatbot - Backend Environment Variables (.env.example)
# ===================================================================
# Copy this file to .env or set these in your hosting environment / Docker / Kubernetes
# NEVER commit production secrets or passwords to Git.

# Database Connection (Leave empty or set to custom SQL Server connection string)
DB_CONNECTION_STRING=Server=.;Database=VehicleServiceChatbotDB_New;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Authentication Secret Key (Must be at least 32 characters long)
JWT_SECRET_KEY=SuperSecretKeyForVehicleServiceChatbotWhichIsAtLeast32BytesLong!
JWT_ISSUER=VehicleServiceChatbotAPI
JWT_AUDIENCE=VehicleServiceChatbotFrontend

# Allowed CORS Origins (comma or semicolon separated)
ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development
